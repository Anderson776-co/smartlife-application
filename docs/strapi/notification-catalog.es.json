[
  {
    "code": "VISIT_AUTHORIZATION_CREATED",
    "subject": "{{authorizatorName}} te autorizó una visita en {{location}}",
    "content": "<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f4f4f7;padding:24px 0;font-family:Arial,Helvetica,sans-serif;\">\n  <tr><td align=\"center\">\n    <table width=\"560\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#ffffff;border-radius:8px;padding:32px;\">\n      <tr><td>\n        <h2 style=\"margin:0 0 16px;color:#111111;\">Hola, {{visitorName}}</h2>\n        <p style=\"color:#444444;line-height:1.5;margin:0 0 16px;\">\n          <strong>{{authorizatorName}}</strong> autorizó tu visita a <strong>{{location}}</strong>.\n        </p>\n        <table cellpadding=\"6\" cellspacing=\"0\" style=\"color:#444444;font-size:14px;margin:0 0 16px;\">\n          <tr><td><strong>Motivo:</strong></td><td>{{reason}}</td></tr>\n          <tr><td><strong>Desde:</strong></td><td>{{startDate}}</td></tr>\n          <tr><td><strong>Hasta:</strong></td><td>{{endDate}}</td></tr>\n          <tr><td><strong>Placa:</strong></td><td>{{vehiclePlate}}</td></tr>\n        </table>\n        <p style=\"color:#444444;margin:0 0 8px;\">Presenta este código QR al ingresar:</p>\n        <p style=\"text-align:center;margin:0 0 16px;\"><img src=\"cid:visit-qr\" alt=\"Código QR de la visita\" width=\"200\" height=\"200\" style=\"display:inline-block;\" /></p>\n        <p style=\"font-size:12px;color:#888888;margin:0;\">Si no ves la imagen, abre este enlace: <a href=\"{{qrUrl}}\">{{qrUrl}}</a></p>\n      </td></tr>\n    </table>\n  </td></tr>\n</table>"
  }
]